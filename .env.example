# DataHub GMS (read + optional write-back)
# Local quickstart: http://localhost:8080 (token empty)
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_TOKEN=

# Rewrite: deterministic (default) | llm
CASCADE_MODE=deterministic

# Only if CASCADE_MODE=llm
# CASCADE_LLM_PROVIDER=openai
# LLM_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
LLM_TIMEOUT_SEC=15
LLM_MAX_LATENCY_MS=15000

CASCADE_WRITEBACK=
GITHUB_TOKEN=
GITHUB_REPOSITORY=
CASCADE_PR_NUMBER=
CASCADE_SOURCE_URN=
CASCADE_OPEN_DOWNSTREAM_PR=
CASCADE_DOWNSTREAM_HEAD=
CASCADE_DOWNSTREAM_BASE=main
