# DataHub GMS (read + optional write-back)
# Local quickstart: http://localhost:8080 (token empty)
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_TOKEN=

# Rewrite: deterministic (default) | llm
CASCADE_MODE=deterministic

# Only if CASCADE_MODE=llm
# CASCADE_LLM_PROVIDER=openai
# LLM_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
LLM_TIMEOUT_SEC=15
LLM_MAX_LATENCY_MS=15000

CASCADE_WRITEBACK=
GITHUB_TOKEN=
GITHUB_REPOSITORY=
CASCADE_PR_NUMBER=
CASCADE_SOURCE_URN=
# Set by the Action only when someone comments /cascade stack
CASCADE_OPEN_DOWNSTREAM_PR=
CASCADE_DOWNSTREAM_HEAD=
CASCADE_DOWNSTREAM_BASE=main

# ---------------------------------------------------------------------------
# Hosted dashboard (site + api/server.py). Not used by the CLI or Action.
# ---------------------------------------------------------------------------
# SQLite locally. On Vercel the default is /tmp/cascade.db (ephemeral).
# postgres:// and libsql:// are recognized but not wired yet.
DATABASE_URL=sqlite:///./cascade.db
SESSION_SECRET=
# Public URL of this site (OAuth callback + CORS). Example: http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Local test harness: creates an HTTP-only session for user "dev" at /auth/dev-login.
# Never enable in production.
CASCADE_DEV_LOGIN=

# GitHub OAuth App (Sign in with GitHub)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional override; default is {PUBLIC_BASE_URL}/auth/github/callback
# GITHUB_OAUTH_REDIRECT_URI=

# GitHub App — create on github.com when ready (Phase 0). Server env only.
# Never expose the private key to the frontend.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# Or path to a PEM file:
# GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

