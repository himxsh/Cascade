# DataHub GMS (read + optional write-back)
# Local quickstart: http://localhost:8080 (token empty)
# DataHub Cloud / remote: https://<your-gms-host> + personal access token
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_TOKEN=

# Set to 1/true ONLY on trusted envs (laptop demo or a dedicated apply job).
# Default unset = dry-run JSON artifacts only (safe for CI).
CASCADE_WRITEBACK=

# GitHub (PR comment / downstream PR). Action provides GITHUB_TOKEN automatically.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
CASCADE_PR_NUMBER=
# Optional: dataset URN when path mapping in .cascade/config.json does not match
CASCADE_SOURCE_URN=
# Set to 1 to create/update cascade/remediation/{pr} via Git Data API (Action sets this)
CASCADE_OPEN_DOWNSTREAM_PR=
# Optional override: open a PR from an already-pushed branch (skips Git Data commit unless OPEN=1)
CASCADE_DOWNSTREAM_HEAD=
CASCADE_DOWNSTREAM_BASE=main

# LLM is primary when LLM_API_KEY is set; deterministic only on failure / high latency.
# Bedrock Mantle example — paste your Bedrock API key into LLM_API_KEY:
LLM_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
LLM_MODEL=deepseek.v3.2
# Abort slow calls; fall back to deterministic rewrite
LLM_TIMEOUT_SEC=15
LLM_MAX_LATENCY_MS=15000
