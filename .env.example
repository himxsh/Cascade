# DataHub GMS (read + optional write-back)
# Local quickstart: http://localhost:8080 (token empty)
# DataHub Cloud / remote: https://<your-gms-host> + personal access token
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_TOKEN=

# Set to 1/true ONLY on trusted envs (laptop demo or a dedicated apply job).
# Default unset = dry-run JSON artifacts only (safe for CI).
CASCADE_WRITEBACK=

# GitHub (PR comment / downstream PR). Action provides GITHUB_TOKEN automatically.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
CASCADE_PR_NUMBER=
# Optional: dataset URN when path mapping in .cascade/config.json does not match
CASCADE_SOURCE_URN=
# Optional: open a real downstream PR from an already-pushed branch with rewrites applied
CASCADE_DOWNSTREAM_HEAD=
CASCADE_DOWNSTREAM_BASE=main

# LLM strategy/rewrite (primary when set; deterministic demo agent otherwise)
LLM_API_KEY=
# Alias accepted by cascade/agent.py
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
