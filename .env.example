# DataHub GMS (read + optional write-back)
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_TOKEN=

# Set to 1/true to emit live DataHub write-backs (default: dry-run artifacts only)
CASCADE_WRITEBACK=

# GitHub (PR comment / downstream PR). Action provides GITHUB_TOKEN automatically.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
CASCADE_PR_NUMBER=

# Optional LLM strategy/rewrite override (demo agent used when unset)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
