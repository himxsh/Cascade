# DataHub GMS (required for --source live)
DATAHUB_GMS_URL=https://your-gms.example.com
DATAHUB_TOKEN=

# Rewrite: off is report only; llm enables fixes
CASCADE_MODE=off

# Only if CASCADE_MODE=llm
# CASCADE_LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=

# Optional live DataHub tags (trusted CI only)
# CASCADE_WRITEBACK=
